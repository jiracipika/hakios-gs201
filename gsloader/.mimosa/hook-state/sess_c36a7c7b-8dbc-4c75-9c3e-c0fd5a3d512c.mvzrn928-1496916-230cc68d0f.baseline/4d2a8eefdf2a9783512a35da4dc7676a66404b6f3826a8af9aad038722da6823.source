#!/bin/bash
# build gsloader.bin — bare-metal arm64, no SIMD, strict alignment (device memory until XNU's MMU).
# Needs: theos clang (any real clang works) and an ELF lld (conda lldenv via micromamba).
set -e
cd "$(dirname "$0")"
CLANG="${CLANG:-$HOME/theos/toolchain/linux/iphone/bin/clang}"
LLENV="$HOME/.local/lldenv/bin"
CFLAGS="--target=aarch64-none-elf -ffreestanding -fno-builtin -fno-stack-protector \
  -mgeneral-regs-only -mstrict-align -O1 -Wall -Wextra -nostdlib -fuse-ld=lld -B$LLENV"
"$CLANG" $CFLAGS -Wl,--build-id=none -T link.ld start.S loader.c -o gsloader.elf
OBJCOPY="$LLENV/llvm-objcopy"
[ -x "$OBJCOPY" ] || OBJCOPY="$HOME/theos/toolchain/linux/iphone/bin/llvm-objcopy"
"$OBJCOPY" -O binary gsloader.elf gsloader.bin
ls -la gsloader.bin gsloader.elf
